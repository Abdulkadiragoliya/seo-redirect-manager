    "404-monitor",
    "short-links",
    "url-aliases",
    "craft-cloud"
  ],
  "license": "MIT",
  "homepage": "https://github.com/abdulkadir/seo-redirect-manager",
  "support": {
    "email": "abdulkadir.agoliya@gmail.com",
    "docs": "https://github.com/abdulkadir/seo-redirect-manager#readme",
    "issues": "https://github.com/abdulkadir/seo-redirect-manager/issues"
  },
  "authors": [
    {
      "name": "Abdulkadir Agoliya",
      "homepage": "https://github.com/abdulkadir"
    }
  ],
  "require": {
    "php": "^8.2.0",
    "craftcms/cms": "^5.0.0"
  },
  "autoload": {
